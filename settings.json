{
  "model": "sonet",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "mattpocock": {
      "source": {
        "source": "git",
        "url": "https://github.com/mattpocock/skills.git"
      }
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(*/.venv/Scripts/python.exe -m pytest:*)",
      "Bash(*/.venv/Scripts/python.exe tools/:*)",
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(python tools/issues.py:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(date:*)",
      "Bash(*/.venv/Scripts/python.exe -c:*)",
      "Bash(rm -f out/issues-existing.json)",
      "Edit",
      "Write",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh label list:*)",
      "Bash(node test/:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(du:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(awk:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(basename:*)",
      "Bash(which:*)"
    ]
  },
  "effortLevel": "xhigh",
  "remoteControlAtStartup": false,
  "autoContinueAtUsageLimit": true,
  "fileCheckpointingEnabled": true,
  "askUserQuestionTimeout": "10m"
}
